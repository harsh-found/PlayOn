{
  "name": "playon",
  "version": "1.0.1",
  "type": "module",
  "description": "PlayOn — zero-dependency Cloudflare Workers live-sports aggregator, match reconciliation engine, and edge stream router",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 3000 --ip 0.0.0.0 --show-interactive-dev-session=false",
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/index.js",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "npx --yes tsx scripts/lint.ts",
    "smoke": "npx --yes tsx scripts/smoke.ts",
    "bench": "npx --yes tsx scripts/bench.ts"
  },
  "keywords": [
    "playon",
    "cloudflare-worker",
    "live-sports",
    "stream-router",
    "hls"
  ],
  "author": "PlayOn",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.86.0"
  }
}
